<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Full assets here (the plugin excludes runtime): tests need the Jellyfin types loadable. -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" />
    <!-- Brings the e_sqlite3 bundle the server would otherwise provide (and inits it). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Parses api/openapi.yaml so the spec can't drift from the DTOs (ContractTests). -->
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real provider responses recorded from the dev server's key; see Fixtures/README.md. -->
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The API contract's live-captured examples, shared with the client app. -->
    <None Include="..\..\api\fixtures\*.json" Link="Contract\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\api\openapi.yaml" Link="Contract\openapi.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Jellyfin.Plugin.KasuMeta\Jellyfin.Plugin.KasuMeta.csproj" />
  </ItemGroup>

</Project>
