root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,yaml,yml,json}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_qualification_for_field = false:suggestion

[tests/**.cs]
# Test names read as sentences: Info_reports_version_and_configured_locales.
dotnet_diagnostic.CA1707.severity = none

[*.cs]
# "FetchQueue" is a queue; the suffix rule targets collection types named after their base.
dotnet_diagnostic.CA1711.severity = none
